package main

import (
	"fmt"
	"strings"
)

// invoiceView is everything the printable invoice shows.
type invoiceView struct {
	Order    Order
	Customer Customer
	Items    []OrderItem
}

// usd formats an amount as $1,799.00.
func usd(f float64) string {
	s := fmt.Sprintf("%.2f", f)
	whole, cents := s[:len(s)-3], s[len(s)-3:]
	neg := strings.HasPrefix(whole, "-")
	whole = strings.TrimPrefix(whole, "-")
	var b strings.Builder
	for i, r := range whole {
		if i > 0 && (len(whole)-i)%3 == 0 {
			b.WriteByte(',')
		}
		b.WriteRune(r)
	}
	if neg {
		return "-$" + b.String() + cents
	}
	return "$" + b.String() + cents
}

// renderTimeMark is replaced with the measured render time after rendering.
const renderTimeMark = "__RENDER_TIME__"

// invoicePage is a server-rendered, print-ready invoice (golaravel + Templ,
// no JavaScript framework).
templ invoicePage(v invoiceView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex"/>
			<title>Invoice { invoiceNumber(v.Order) } · { brand }</title>
			<link rel="icon" href="/admin/favicon.png"/>
			<style>
				:root { --ink: #111827; --muted: #6b7280; --line: #e5e7eb; --accent: #059669; --soft: #ecfdf5; }
				* { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
				body { margin: 0; background: #f3f4f6; color: var(--ink); font: 14px/1.5 system-ui, -apple-system, "Segoe UI", Arial, sans-serif; }
				.bar { max-width: 820px; margin: 24px auto 0; padding: 0 16px; display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; justify-content: space-between; color: var(--muted); font-size: 13px; }
				.speed { display: inline-block; padding: 4px 10px; border-radius: 999px; background: var(--soft); color: #065f46; font-weight: 600; }
				.btn { border: 0; border-radius: 8px; padding: 8px 14px; background: var(--accent); color: #fff; font-weight: 600; cursor: pointer; }
				.sheet { max-width: 820px; margin: 12px auto 40px; background: #fff; padding: 48px; border-radius: 12px; box-shadow: 0 10px 30px -12px rgba(0,0,0,.2); }
				table { width: 100%; border-collapse: collapse; }
				td, th { vertical-align: top; }
				/* layout tables: header and parties */
				table.layout td { padding: 0; }
				table.layout td.right { text-align: right; }
				.logo { font-size: 20px; font-weight: 700; white-space: nowrap; }
				.mark { display: inline-block; width: 34px; height: 34px; line-height: 34px; margin-right: 8px; border-radius: 9px; background: var(--accent); color: #fff; text-align: center; font-weight: 800; vertical-align: middle; }
				.from { color: var(--muted); font-size: 12px; margin-top: 8px; }
				h1 { margin: 0 0 4px; font-size: 28px; letter-spacing: -.02em; }
				.meta { color: var(--muted); }
				table.parties { margin: 32px 0; }
				table.parties td { width: 33%; padding-right: 16px; }
				.label { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); padding-bottom: 4px; }
				.status { display: inline-block; padding: 1px 10px; border-radius: 999px; background: #f3f4f6; border: 1px solid var(--line); font-weight: 600; font-size: 12px; }
				/* line items */
				table.items thead th { text-align: left; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); background: #f9fafb; border-top: 1px solid var(--line); border-bottom: 2px solid var(--line); padding: 8px; }
				table.items tbody td { border-bottom: 1px solid var(--line); padding: 10px 8px; }
				table.items .num { text-align: right; white-space: nowrap; width: 1%; }
				.sku { color: var(--muted); font-size: 12px; }
				table.items tfoot td { padding: 6px 8px; }
				table.items tfoot tr:first-child td { padding-top: 14px; }
				table.items tfoot .grand td { border-top: 2px solid var(--ink); font-size: 18px; font-weight: 700; padding-top: 10px; }
				table.items tfoot .lbl { text-align: right; color: var(--muted); }
				table.items tfoot .grand .lbl { color: var(--ink); }
				footer { margin-top: 40px; color: var(--muted); font-size: 12px; }
				@media screen and (max-width: 600px) {
					.sheet { padding: 20px; border-radius: 0; }
					table.layout td, table.parties td { display: block; width: auto; text-align: left !important; padding: 0 0 16px; }
				}
				@page { size: A4; margin: 16mm 14mm; }
				@media print {
					body { background: #fff; font-size: 12px; }
					.bar { display: none; }
					.sheet { box-shadow: none; border-radius: 0; margin: 0; max-width: none; padding: 0; }
					thead { display: table-header-group; } /* repeat the column headings on each page */
					tfoot { display: table-row-group; }    /* totals only once, at the end */
					tr, table.parties, table.layout { break-inside: avoid; page-break-inside: avoid; }
				}
			</style>
		</head>
		<body>
			<div class="bar">
				<span class="speed" title="Time the Go server took to render this page with Templ">⚡ Rendered on the server in { renderTimeMark }</span>
				<span>Generated by GoLaravel + Templ, no JavaScript framework</span>
				<button class="btn" type="button" onclick="window.print()">Print or save as PDF</button>
			</div>
			<main class="sheet">
				<table class="layout" role="presentation">
					<tr>
						<td>
							<div class="logo"><span class="mark">A</span>{ brand }</div>
							<div class="from">12 Market Street, Lisbon, Portugal<br/>billing@apexstore.example · VAT PT 500 000 000</div>
						</td>
						<td class="right">
							<h1>Invoice</h1>
							<div class="meta">
								{ invoiceNumber(v.Order) }<br/>
								Order { v.Order.Number }<br/>
								{ v.Order.CreatedAt.Format("2 January 2006") }
							</div>
						</td>
					</tr>
				</table>
				<table class="parties" role="presentation">
					<tr>
						<td>
							<div class="label">Billed to</div>
							<strong>{ v.Customer.Name }</strong><br/>
							{ v.Customer.Email }<br/>
							{ v.Customer.City }, { v.Customer.Country }
						</td>
						<td>
							<div class="label">Payment</div>
							{ paymentLabel(v.Order.Payment) }<br/>
							<span class="status">{ orderStatus[v.Order.Status] }</span>
						</td>
						<td>
							if v.Order.Tracking != "" {
								<div class="label">Shipment</div>
								Tracking { v.Order.Tracking }
							}
						</td>
					</tr>
				</table>
				<table class="items">
					<thead>
						<tr><th scope="col">Item</th><th scope="col" class="num">Qty</th><th scope="col" class="num">Unit price</th><th scope="col" class="num">Amount</th></tr>
					</thead>
					<tbody>
						for _, it := range v.Items {
							<tr>
								<td>{ it.Product }<div class="sku">{ it.SKU }</div></td>
								<td class="num">{ fmt.Sprint(it.Quantity) }</td>
								<td class="num">{ usd(it.UnitPrice) }</td>
								<td class="num">{ usd(it.Total) }</td>
							</tr>
						}
					</tbody>
					<tfoot>
						<tr><td colspan="3" class="lbl">Subtotal</td><td class="num">{ usd(v.Order.Subtotal) }</td></tr>
						<tr><td colspan="3" class="lbl">Shipping</td><td class="num">{ usd(v.Order.Shipping) }</td></tr>
						<tr class="grand"><td colspan="3" class="lbl">Total</td><td class="num">{ usd(v.Order.Total) }</td></tr>
					</tfoot>
				</table>
				<footer>
					Thank you for shopping with { brand }. This is a sample invoice from the GoFilament live demo; no payment was taken.
				</footer>
			</main>
		</body>
	</html>
}

package main

import "fmt"

// invoiceView is everything the printable invoice shows.
type invoiceView struct {
	Order    Order
	Customer Customer
	Items    []OrderItem
}

func usd(f float64) string { return fmt.Sprintf("$%.2f", f) }

// renderTimeMark is replaced with the measured render time after rendering.
const renderTimeMark = "__RENDER_TIME__"

// invoicePage is a server-rendered, print-ready invoice (golaravel + Templ,
// no JavaScript framework).
templ invoicePage(v invoiceView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex"/>
			<title>Invoice { invoiceNumber(v.Order) } · { brand }</title>
			<link rel="icon" href="/admin/favicon.png"/>
			<style>
				:root { --ink: #111827; --muted: #6b7280; --line: #e5e7eb; --accent: #059669; }
				* { box-sizing: border-box; }
				body { margin: 0; background: #f3f4f6; color: var(--ink); font: 14px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
				.bar { max-width: 820px; margin: 24px auto 0; padding: 0 16px; display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; justify-content: space-between; color: var(--muted); font-size: 13px; }
				.speed { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; background: #ecfdf5; color: #065f46; font-weight: 600; }
				.btn { border: 0; border-radius: 8px; padding: 8px 14px; background: var(--accent); color: #fff; font-weight: 600; cursor: pointer; }
				.sheet { max-width: 820px; margin: 12px auto 40px; background: #fff; padding: 48px; border-radius: 12px; box-shadow: 0 10px 30px -12px rgba(0,0,0,.2); }
				header { display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between; align-items: flex-start; }
				.logo { display: flex; align-items: center; gap: 10px; font-size: 20px; font-weight: 700; }
				.mark { width: 36px; height: 36px; border-radius: 9px; background: var(--accent); color: #fff; display: grid; place-items: center; font-weight: 800; }
				h1 { margin: 0; font-size: 28px; letter-spacing: -.02em; text-align: right; }
				.meta { color: var(--muted); text-align: right; }
				.cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; margin: 36px 0; }
				.label { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
				table { width: 100%; border-collapse: collapse; }
				th { text-align: left; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); border-bottom: 2px solid var(--line); padding: 8px 6px; }
				td { border-bottom: 1px solid var(--line); padding: 10px 6px; vertical-align: top; }
				.num { text-align: right; white-space: nowrap; }
				.sku { color: var(--muted); font-size: 12px; }
				.totals { margin-left: auto; width: min(100%, 300px); margin-top: 16px; }
				.totals div { display: flex; justify-content: space-between; padding: 6px 6px; }
				.grand { border-top: 2px solid var(--ink); font-size: 18px; font-weight: 700; margin-top: 4px; }
				.status { display: inline-block; padding: 2px 10px; border-radius: 999px; background: #f3f4f6; font-weight: 600; font-size: 12px; }
				footer { margin-top: 40px; color: var(--muted); font-size: 12px; }
				@media (max-width: 600px) { .sheet { padding: 24px; } h1, .meta { text-align: left; } }
				@media print {
					body { background: #fff; }
					.bar { display: none; }
					.sheet { box-shadow: none; margin: 0; max-width: none; padding: 0; }
				}
			</style>
		</head>
		<body>
			<div class="bar">
				<span class="speed" title="Time the Go server took to render this page with Templ">⚡ Rendered on the server in { renderTimeMark }</span>
				<span>Generated by GoLaravel + Templ, no JavaScript framework</span>
				<button class="btn" type="button" onclick="window.print()">Print or save as PDF</button>
			</div>
			<main class="sheet">
				<header>
					<div>
						<div class="logo"><span class="mark">A</span>{ brand }</div>
						<p class="sku">12 Market Street, Lisbon, Portugal<br/>billing@apexstore.example · VAT PT 500 000 000</p>
					</div>
					<div>
						<h1>Invoice</h1>
						<div class="meta">
							{ invoiceNumber(v.Order) }<br/>
							Order { v.Order.Number }<br/>
							{ v.Order.CreatedAt.Format("2 January 2006") }
						</div>
					</div>
				</header>
				<section class="cols">
					<div>
						<div class="label">Billed to</div>
						<strong>{ v.Customer.Name }</strong><br/>
						{ v.Customer.Email }<br/>
						{ v.Customer.City }, { v.Customer.Country }
					</div>
					<div>
						<div class="label">Payment</div>
						{ paymentLabel(v.Order.Payment) }<br/>
						<span class="status">{ orderStatus[v.Order.Status] }</span>
					</div>
					if v.Order.Tracking != "" {
						<div>
							<div class="label">Shipment</div>
							Tracking { v.Order.Tracking }
						</div>
					}
				</section>
				<table>
					<thead>
						<tr><th>Item</th><th class="num">Qty</th><th class="num">Unit price</th><th class="num">Amount</th></tr>
					</thead>
					<tbody>
						for _, it := range v.Items {
							<tr>
								<td>{ it.Product }<div class="sku">{ it.SKU }</div></td>
								<td class="num">{ fmt.Sprint(it.Quantity) }</td>
								<td class="num">{ usd(it.UnitPrice) }</td>
								<td class="num">{ usd(it.Total) }</td>
							</tr>
						}
					</tbody>
				</table>
				<div class="totals">
					<div><span>Subtotal</span><span>{ usd(v.Order.Subtotal) }</span></div>
					<div><span>Shipping</span><span>{ usd(v.Order.Shipping) }</span></div>
					<div class="grand"><span>Total</span><span>{ usd(v.Order.Total) }</span></div>
				</div>
				<footer>
					Thank you for shopping with { brand }. This is a sample invoice from the GoFilament live demo; no payment was taken.
				</footer>
			</main>
		</body>
	</html>
}
